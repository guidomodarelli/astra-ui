{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "paths": {
      "@/*": ["../src/*"],
      "beez-ui": ["../dist/index"],
      "beez-ui/next": ["../dist/next"],
      "beez-ui/tanstack": ["../dist/tanstack"],
      "beez-ui/hooks": ["../dist/hooks"]
    },
    "types": ["node", "@testing-library/jest-dom/vitest", "vite/client"]
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "../vitest.config.ts",
    "../playwright.config.ts",
    "../vitest.setup.ts"
  ]
}
